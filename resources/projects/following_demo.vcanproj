        "initial": "OFF",
        "states": [
          "OFF",
          "RUN",
          "FAULT"
        ],
        "transitions": [
          {
            "from": "OFF",
            "to": "RUN",
            "when": "ignition"
          },
          {
            "from": "RUN",
            "to": "FAULT",
            "when": "radar_fault"
          },
          {
            "from": "FAULT",
            "to": "RUN",
            "when": {
              "args": [
                "radar_fault",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "RUN",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          }
        ]
      },
      "tasks": [
        {
          "assign": {
            "obj0_closing_speed": "closing_speed_sensor",
            "obj0_range": "radar_distance_sensor",
            "obj1_closing_speed": "speed_sensor",
            "obj1_range": "static_object_sensor",
            "radar_fault": {
              "args": [
                {
                  "args": [
                    "radar_distance_sensor",
                    600
                  ],
                  "op": "gt"
                },
                {
                  "args": [
                    "radar_distance_sensor",
                    0
                  ],
                  "op": "lt"
                }
              ],
              "op": "or"
            }
          },
          "cost_us": 220,
          "name": "radar_sampling",
          "period_ms": 10
        },
        {
          "assign": {
            "obj0_confidence": {
              "args": [
                "radar_fault",
                0,
                100
              ],
              "op": "if"
            },
            "obj0_valid": {
              "args": [
                "radar_fault",
                0
              ],
              "op": "eq"
            },
            "obj1_confidence": {
              "args": [
                {
                  "args": [
                    "static_object_sensor",
                    500
                  ],
                  "op": "lt"
                },
                100,
                0
              ],
              "op": "if"
            },
            "obj1_valid": {
              "args": [
                "static_object_sensor",
                500
              ],
              "op": "lt"
            },
