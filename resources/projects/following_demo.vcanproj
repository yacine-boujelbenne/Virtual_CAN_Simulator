                      ],
                      "op": "gt"
                    },
                    {
                      "args": [
                        "wheel_slip",
                        0.12
                      ],
                      "op": "gt"
                    }
                  ],
                  "op": "and"
                }
              ],
              "op": "and"
            }
          },
          "name": "abs_control",
          "period_ms": 10
        },
        {
          "assign": {
            "pressure": {
              "args": [
                "abs_active",
                {
                  "args": [
                    "combined_brake",
                    0.45
                  ],
                  "op": "mul"
                },
                "combined_brake"
              ],
              "op": "if"
            }
          },
          "name": "actuate",
          "period_ms": 10
        }
      ],
      "variables": {
        "abs_active": 0,
        "combined_brake": 0,
        "pressure": 0,
        "wheel_slip": 0
