      "name": "Motor ECU",
      "schema_version": 1,
      "state_machine": {
        "initial": "OFF",
        "states": [
          "OFF",
          "RUN",
          "FAULT"
        ],
        "transitions": [
          {
            "from": "OFF",
            "to": "RUN",
            "when": "ignition"
          },
          {
            "from": "RUN",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "RUN",
            "to": "FAULT",
            "when": "motor_fault"
          },
          {
            "from": "FAULT",
            "to": "RUN",
            "when": {
              "args": [
                "motor_fault",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "FAULT",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          }
        ]
      },
      "tasks": [
        {
          "assign": {
            "motor_fault": {
              "args": [
                "temperature_sensor",
                115
              ],
              "op": "gt"
            },
            "motor_rpm": "rpm_sensor",
            "motor_temperature": "temperature_sensor"
          },
          "name": "measure",
          "period_ms": 10
        },
        {
          "assign": {
            "fan_cmd": {
              "args": [
                "motor_temperature",
                90
              ],
              "op": "gt"
            },
            "motor_torque": {
              "args": [
                {
                  "args": [
                    "aeb_request",
                    0,
                    {
                      "args": [
                        {
                          "args": [
