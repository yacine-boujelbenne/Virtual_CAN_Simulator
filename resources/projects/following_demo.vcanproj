    "../ecu_templates/eps.json": {
      "assumptions": [
        "Generic educational EPS model; not an OEM controller.",
        "Road-wheel angle follows the normalized driver request with a fixed 0.6 rad limit.",
        "The assist limit is the EPS actuator capability, not the plant steering limit; when the scenario plant max_steer_angle_rad is lower, the world reports the saturated angle the kinematic bicycle actually used."
      ],
