      "name": "ADAS ECU",
      "schema_version": 1,
      "state_machine": {
        "initial": "OFF",
        "states": [
          "OFF",
          "MONITORING",
          "CRUISE",
          "WARNING",
          "BRAKING",
          "FAULT"
        ],
        "transitions": [
          {
            "from": "OFF",
            "to": "MONITORING",
            "when": "ignition"
          },
          {
            "from": "MONITORING",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "CRUISE",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "WARNING",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "BRAKING",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "FAULT",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "MONITORING",
            "to": "FAULT",
            "when": "adas_fault"
          },
          {
            "from": "CRUISE",
            "to": "FAULT",
            "when": "adas_fault"
          },
          {
            "from": "WARNING",
            "to": "FAULT",
            "when": "adas_fault"
          },
          {
            "from": "BRAKING",
            "to": "FAULT",
            "when": "adas_fault"
          },
          {
            "from": "MONITORING",
            "to": "BRAKING",
            "when": "aeb_request"
          },
          {
            "from": "CRUISE",
            "to": "BRAKING",
            "when": "aeb_request"
          },
          {
            "from": "WARNING",
            "to": "BRAKING",
            "when": "aeb_request"
          },
          {
            "from": "MONITORING",
            "to": "WARNING",
            "when": "fcw"
          },
          {
            "from": "CRUISE",
            "to": "WARNING",
            "when": "fcw"
          },
          {
            "from": "MONITORING",
            "to": "CRUISE",
            "when": "acc_active"
          },
          {
            "from": "CRUISE",
            "to": "MONITORING",
            "when": {
              "args": [
                "acc_active",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "WARNING",
            "to": "MONITORING",
            "when": {
              "args": [
                "fcw",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "BRAKING",
            "to": "MONITORING",
            "when": {
              "args": [
                "aeb_request",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "FAULT",
            "to": "MONITORING",
            "when": {
              "args": [
                "adas_fault",
                0
              ],
              "op": "eq"
            }
          }
        ]
      },
      "tasks": [
        {
          "assign": {
            "adas_fault": {
              "args": [
                {
                  "args": [
                    "startup_ms",
                    100
                  ],
                  "op": "lt"
                },
                0,
                {
                  "args": [
                    {
                      "args": [
                        "radar_valid",
                        0
                      ],
                      "op": "eq"
                    },
                    {
                      "args": [
                        "radar_age_ms",
                        100
                      ],
                      "op": "gt"
                    }
                  ],
                  "op": "or"
                }
              ],
              "op": "if"
            },
            "perception_gap": {
              "args": [
                {
                  "args": [
                    "obj0_range",
                    "front_perception_sensor"
                  ],
                  "op": "sub"
                },
                {
                  "args": [
                    "front_perception_sensor",
                    "obj0_range"
                  ],
                  "op": "sub"
                }
              ],
              "op": "max"
            },
            "startup_ms": {
              "args": [
                200,
                {
                  "args": [
                    "startup_ms",
                    10
                  ],
                  "op": "add"
                }
              ],
              "op": "min"
            },
            "time_to_collision": {
              "args": [
                99,
                {
                  "args": [
                    "obj0_range",
                    {
                      "args": [
                        "obj0_closing_speed",
                        0.1
                      ],
                      "op": "max"
                    }
                  ],
                  "op": "div"
                }
              ],
              "op": "min"
            }
          },
          "cost_us": 450,
          "name": "fusion",
          "period_ms": 10
        },
        {
          "assign": {
            "fusion_disagree": {
              "args": [
                "perception_gap",
                5
              ],
              "op": "gt"
            }
          },
          "cost_us": 120,
          "name": "fusion_consistency",
          "period_ms": 10
        },
        {
          "assign": {
            "perception_valid": {
              "args": [
                {
                  "args": [
                    "radar_valid",
                    1
                  ],
                  "op": "eq"
                },
                {
                  "args": [
                    "fusion_disagree",
