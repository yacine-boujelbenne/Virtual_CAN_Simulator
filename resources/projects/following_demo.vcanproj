                          ],
                          "op": "and"
                        },
                        {
                          "args": [
                            {
                              "args": [
                                {
                                  "args": [
                                    "acc_active",
                                    "acc_throttle",
                                    "throttle"
                                  ],
                                  "op": "if"
                                },
                                320
                              ],
                              "op": "mul"
                            },
                            "power_permit"
                          ],
                          "op": "mul"
                        },
                        0
                      ],
                      "op": "if"
                    }
                  ],
                  "op": "if"
                },
                "drive_permit"
              ],
              "op": "mul"
            }
          },
          "name": "control",
          "period_ms": 10
        }
      ],
