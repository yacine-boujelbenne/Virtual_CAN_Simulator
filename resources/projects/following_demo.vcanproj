      "name": "ABS ECU",
      "schema_version": 1,
      "state_machine": {
        "initial": "OFF",
        "states": [
          "OFF",
          "RUN",
          "ABS_ACTIVE"
        ],
        "transitions": [
          {
            "from": "OFF",
            "to": "RUN",
            "when": "ignition"
          },
          {
            "from": "RUN",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "RUN",
            "to": "ABS_ACTIVE",
            "when": "abs_active"
          },
          {
            "from": "ABS_ACTIVE",
            "to": "RUN",
            "when": {
              "args": [
                "abs_active",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "ABS_ACTIVE",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          }
        ]
      },
      "tasks": [
        {
          "assign": {
            "combined_brake": {
              "args": [
                "brake",
                "aeb_request"
              ],
              "op": "max"
            }
          },
          "cost_us": 100,
          "name": "brake_request_arbitration",
          "period_ms": 10
        },
        {
          "assign": {
            "wheel_slip": {
              "args": [
                0,
                {
                  "args": [
                    {
                      "args": [
