    "../ecu_templates/bms.json": {
      "assumptions": [
        "Generic educational model; not an OEM controller.",
        "Classic CAN, little-endian signals, 10 ms simulation step."
      ],
      "bindings": {
        "power_allowed": "power_permit"
      },
      "domain": "Energy",
      "dtcs": [
        {
          "code": "P0A7E",
          "name": "Battery overtemperature",
          "recover": {
            "args": [
              "battery_temperature_sensor",
              55
            ],
            "op": "lt"
          },
          "severity": "critical",
          "trigger": {
            "args": [
              "battery_temperature_sensor",
              60
            ],
            "op": "gt"
          },
          "uds_code": 687616
        },
        {
          "code": "P0AFA",
          "name": "Battery SOC low",
          "recover": {
            "args": [
              "battery_soc",
              10
            ],
            "op": "gt"
          },
          "severity": "warning",
          "trigger": {
            "args": [
              "battery_soc",
              5
            ],
            "op": "lt"
          },
          "uds_code": 719360
        }
      ],
      "hardware": {
        "adc": {
          "channels": {
            "battery_temperature_sensor": [
              -40,
              100
            ],
            "current_sensor": [
              -300,
              300
            ],
            "voltage_sensor": [
              0,
              600
            ]
          },
          "resolution_bits": 12
        },
        "can_controller": {
          "fd_capable": true,
          "rx_fifo_frames": 128
        },
        "cpu_mhz": 120,
        "flash_kib": 512,
        "gpio_outputs": [
          "power_permit"
        ],
        "ram_kib": 128,
        "task_budget_us": 8000
      },
      "inputs": [
        "ignition",
        "soc_sensor",
        "voltage_sensor",
        "current_sensor",
        "battery_temperature_sensor"
      ],
      "messages": [
        {
          "brs": false,
          "bus": "powertrain",
          "direction": "tx",
          "dlc": 8,
          "fd": false,
          "id": 784,
          "name": "BatteryStatus",
          "period_ms": 100,
          "signals": [
            {
              "byte_order": "little_endian",
              "factor": 0.01,
              "length": 16,
              "max": 100,
              "min": 0,
              "name": "battery_soc",
              "offset": 0,
              "signed": false,
              "start": 0,
              "unit": "%"
            },
            {
              "byte_order": "little_endian",
              "factor": 0.01,
              "length": 16,
              "max": 600,
              "min": 0,
              "name": "pack_voltage",
              "offset": 0,
              "signed": false,
              "start": 16,
              "unit": "V"
            },
            {
              "byte_order": "little_endian",
              "factor": 0.01,
              "length": 16,
              "max": 300,
              "min": -300,
              "name": "pack_current",
              "offset": 0,
              "signed": true,
              "start": 32,
              "unit": "A"
            },
            {
              "byte_order": "little_endian",
              "factor": 1,
              "length": 1,
              "max": 1,
              "min": 0,
              "name": "battery_fault",
              "offset": 0,
              "signed": false,
              "start": 48,
              "unit": ""
            },
            {
              "byte_order": "little_endian",
              "factor": 1,
              "length": 1,
              "max": 1,
              "min": 0,
              "name": "power_permit",
              "offset": 0,
              "signed": false,
              "start": 49,
              "unit": ""
            }
          ]
        }
      ],
      "name": "BMS ECU",
      "schema_version": 1,
      "state_machine": {
        "initial": "OFF",
        "states": [
          "OFF",
          "RUN",
          "FAULT"
        ],
        "transitions": [
          {
            "from": "OFF",
            "to": "RUN",
            "when": "ignition"
          },
          {
            "from": "RUN",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "RUN",
            "to": "FAULT",
            "when": "battery_fault"
          },
          {
            "from": "FAULT",
            "to": "RUN",
            "when": {
              "args": [
                "battery_fault",
                0
              ],
              "op": "eq"
            }
          },
          {
            "from": "FAULT",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          }
        ]
      },
      "tasks": [
        {
          "assign": {
            "battery_fault": {
              "args": [
                {
                  "args": [
                    "battery_temperature_sensor",
                    60
                  ],
                  "op": "gt"
                },
                {
                  "args": [
                    "soc_sensor",
                    5
                  ],
                  "op": "lt"
                }
              ],
              "op": "or"
            },
            "battery_soc": "soc_sensor",
            "pack_current": "current_sensor",
            "pack_voltage": "voltage_sensor"
          },
          "name": "monitor",
          "period_ms": 10
        },
        {
          "assign": {
            "power_permit": {
              "args": [
                "ignition",
                {
                  "args": [
                    "battery_fault",
                    0
                  ],
                  "op": "eq"
                }
              ],
              "op": "and"
            }
          },
          "name": "contactor",
          "period_ms": 10
        }
      ],
      "variables": {
        "battery_fault": 0,
        "battery_soc": 85,
        "pack_current": 0,
        "pack_voltage": 390,
        "power_permit": 1
      }
    },
