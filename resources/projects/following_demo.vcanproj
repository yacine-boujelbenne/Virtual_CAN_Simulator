                                "wheel_fr_sensor"
                              ],
                              "op": "min"
                            },
                            {
                              "args": [
                                "wheel_rl_sensor",
                                "wheel_rr_sensor"
                              ],
                              "op": "min"
                            }
                          ],
                          "op": "min"
                        }
                      ],
                      "op": "sub"
                    },
                    {
                      "args": [
                        "speed_sensor",
                        0.5
                      ],
                      "op": "max"
                    }
                  ],
                  "op": "div"
                }
              ],
              "op": "max"
            }
          },
          "name": "slip",
          "period_ms": 10
        },
        {
          "assign": {
            "abs_active": {
              "args": [
                {
                  "args": [
                    "speed_sensor",
                    2
                  ],
                  "op": "gt"
                },
                {
                  "args": [
                    {
