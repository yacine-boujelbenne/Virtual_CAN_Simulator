    "../ecu_templates/transmission.json": {
      "assumptions": [
        "Generic educational transmission model; not an OEM controller.",
        "Gear encoding is 0=P, 1=N, 2=D. Reverse is not implemented.",
        "Drive permit is broadcast to the motor controller over CAN.",
        "The vehicle plant enforces the parking interlock at actuation time: a delayed Park engagement above park_speed_mps cannot lock the driveline instantly and instead completes a declared pre-lock braking ramp (park_brake_mps2)."
      ],
      "bindings": {
        "drive_permit": "drive_permit",
        "gear_position": "gear_position"
      },
      "domain": "Powertrain",
      "dtcs": [],
      "hardware": {
        "adc": {
          "channels": {},
          "resolution_bits": 12
        },
        "can_controller": {
          "fd_capable": true,
          "rx_fifo_frames": 128
        },
        "cpu_mhz": 120,
        "flash_kib": 512,
        "gpio_outputs": [],
        "ram_kib": 128,
        "task_budget_us": 8000
      },
      "inputs": [
        "ignition",
        "gear",
        "speed_sensor"
      ],
      "messages": [
        {
          "brs": false,
          "bus": "powertrain",
          "direction": "tx",
          "dlc": 8,
          "fd": false,
          "id": 608,
          "name": "DriveStatus",
          "period_ms": 10,
          "signals": [
            {
              "byte_order": "little_endian",
              "factor": 1,
              "length": 1,
              "max": 1,
              "min": 0,
              "name": "drive_permit",
              "offset": 0,
              "signed": false,
              "start": 0,
              "unit": ""
            }
          ]
        },
        {
          "brs": false,
          "bus": "powertrain",
          "direction": "tx",
          "dlc": 8,
          "fd": false,
          "id": 609,
          "name": "GearStatus",
          "period_ms": 20,
          "signals": [
            {
              "byte_order": "little_endian",
              "factor": 1,
              "length": 2,
              "max": 2,
              "min": 0,
              "name": "gear_position",
              "offset": 0,
              "signed": false,
              "start": 0,
              "unit": ""
            }
          ]
        }
      ],
      "name": "Transmission ECU",
      "schema_version": 1,
      "state_machine": {
        "initial": "OFF",
        "states": [
          "OFF",
          "RUN"
        ],
        "transitions": [
          {
            "from": "OFF",
            "to": "RUN",
            "when": "ignition"
          },
          {
            "from": "RUN",
            "to": "OFF",
            "when": {
              "args": [
                "ignition",
                0
              ],
              "op": "eq"
            }
          }
        ]
      },
      "tasks": [
        {
          "assign": {
            "gear_position": {
              "args": [
                {
                  "args": [
                    "gear",
                    2
                  ],
                  "op": "min"
                },
                0
              ],
              "op": "max"
            }
          },
          "cost_us": 80,
          "name": "select",
          "period_ms": 10
        },
        {
          "assign": {
            "drive_permit": {
              "args": [
                {
                  "args": [
                    "ignition",
                    {
                      "args": [
                        "gear_position",
                        2
                      ],
                      "op": "eq"
                    }
                  ],
                  "op": "and"
                },
                1,
                0
              ],
              "op": "if"
            }
          },
          "cost_us": 80,
          "name": "permit",
          "period_ms": 10
        }
      ],
      "variables": {
        "drive_permit": 0,
        "gear_position": 0
      }
    }
  },
