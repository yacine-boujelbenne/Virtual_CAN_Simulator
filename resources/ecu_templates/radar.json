{
  "schema_version": 1,
  "name": "Radar ECU",
  "inputs": [
    "ignition",
    "radar_distance_sensor",
    "closing_speed_sensor",
    "static_object_sensor",
    "speed_sensor"
  ],
  "variables": {
    "obj0_range": 120,
    "obj0_closing_speed": 0,
    "obj0_confidence": 100,
    "obj0_valid": 1,
    "obj1_range": 150,
    "obj1_closing_speed": 0,
    "obj1_confidence": 100,
    "obj1_valid": 1,
    "obj2_range": 0,
    "obj2_closing_speed": 0,
    "obj2_confidence": 0,
    "obj2_valid": 0,
    "obj3_range": 0,
    "obj3_closing_speed": 0,
    "obj3_confidence": 0,
    "obj3_valid": 0,
    "object_count": 0,
    "sample_counter": 0,
    "radar_valid": 1,
    "radar_fault": 0
  },
  "tasks": [
    {
      "name": "radar_sampling",
      "period_ms": 10,
      "cost_us": 220,
      "assign": {
        "obj0_range": "radar_distance_sensor",
        "obj0_closing_speed": "closing_speed_sensor",
        "obj1_range": "static_object_sensor",
        "obj1_closing_speed": "speed_sensor",
        "radar_fault": {
          "op": "or",
          "args": [
            {
              "op": "gt",
              "args": [
                "radar_distance_sensor",
                600
              ]
            },
            {
              "op": "lt",
              "args": [
                "radar_distance_sensor",
                0
              ]
            }
          ]
        }
      }
    },
    {
      "name": "radar_validity",
      "period_ms": 10,
      "cost_us": 200,
      "assign": {
        "obj0_valid": {
          "op": "eq",
          "args": [
            "radar_fault",
            0
          ]
        },
        "obj0_confidence": {
          "op": "if",
          "args": [
            "radar_fault",
            0,
            100
          ]
        },
        "obj1_valid": {
          "op": "lt",
          "args": [
            "static_object_sensor",
            500
          ]
        },
        "obj1_confidence": {
          "op": "if",
          "args": [
            {
              "op": "lt",
              "args": [
                "static_object_sensor",
                500
              ]
            },
            100,
            0
          ]
        },
        "radar_valid": {
          "op": "eq",
          "args": [
            "radar_fault",
            0
          ]
        },
        "object_count": {
          "op": "add",
          "args": [
            {
              "op": "eq",
              "args": [
                "radar_fault",
                0
              ]
            },
            {
              "op": "lt",
              "args": [
                "static_object_sensor",
                500
              ]
            }
          ]
        },
        "sample_counter": {
          "op": "if",
          "args": [
            {
              "op": "gt",
              "args": [
                "sample_counter",
                254
              ]
            },
            0,
            {
              "op": "add",
              "args": [
                "sample_counter",
                1
              ]
            }
          ]
        }
      }
    }
  ],
  "bindings": {},
  "messages": [
    {
      "name": "RadarObjectList",
      "id": 1024,
      "direction": "tx",
      "period_ms": 20,
      "dlc": 32,
      "fd": true,
      "brs": true,
      "bus": "adas",
