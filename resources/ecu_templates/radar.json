  ],
  "state_machine": {
    "initial": "OFF",
    "states": [
      "OFF",
      "RUN",
      "FAULT"
    ],
    "transitions": [
      {
        "from": "OFF",
        "to": "RUN",
        "when": "ignition"
      },
      {
        "from": "RUN",
        "to": "FAULT",
        "when": "radar_fault"
      },
      {
        "from": "FAULT",
        "to": "RUN",
        "when": {
          "op": "eq",
          "args": [
            "radar_fault",
            0
          ]
        }
      },
      {
        "from": "RUN",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      }
    ]
  },
  "dtcs": [
    {
      "code": "C1A10",
      "uds_code": 12689664,
      "name": "Forward radar unavailable",
      "severity": "warning",
      "trigger": "radar_fault",
      "recover": {
        "op": "eq",
        "args": [
          "radar_fault",
          0
        ]
      }
    }
  ],
  "assumptions": [
    "Functional software-in-the-loop demonstration; not production ADAS/ADS.",
    "Radar observations are synthetic sensor measurements, not raw camera/radar perception.",
    "The object list carries four slots; slots 0 (lead vehicle) and 1 (static obstacle) are populated."
  ],
  "hardware": {
    "cpu_mhz": 160,
    "ram_kib": 128,
    "flash_kib": 512,
    "task_budget_us": 8000,
    "adc": {
      "resolution_bits": 12,
      "channels": {}
    },
    "can_controller": {
      "fd_capable": true,
      "rx_fifo_frames": 128
    },
    "gpio_outputs": []
  },
  "domain": "Perception"
}
