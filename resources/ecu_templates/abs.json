{
  "schema_version": 1,
  "name": "ABS ECU",
  "inputs": [
    "ignition",
    "brake",
    "speed_sensor",
    "wheel_fl_sensor",
    "wheel_fr_sensor",
    "wheel_rl_sensor",
    "wheel_rr_sensor"
  ],
  "variables": {
    "wheel_slip": 0,
    "abs_active": 0,
    "pressure": 0
  },
  "tasks": [
    {
      "name": "slip",
      "period_ms": 10,
      "assign": {
        "wheel_slip": {
          "op": "max",
          "args": [
            0,
            {
              "op": "div",
              "args": [
                {
                  "op": "sub",
                  "args": [
                    "speed_sensor",
                    {
                      "op": "min",
                      "args": [
                        {
                          "op": "min",
                          "args": [
                            "wheel_fl_sensor",
                            "wheel_fr_sensor"
                          ]
                        },
                        {
                          "op": "min",
                          "args": [
                            "wheel_rl_sensor",
                            "wheel_rr_sensor"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "max",
                  "args": [
                    "speed_sensor",
                    0.5
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "abs_control",
      "period_ms": 10,
      "assign": {
        "abs_active": {
          "op": "and",
          "args": [
            {
              "op": "gt",
              "args": [
                "speed_sensor",
                2
              ]
            },
            {
              "op": "and",
              "args": [
                {
                  "op": "gt",
                  "args": [
                    "brake",
                    0.05
                  ]
                },
                {
                  "op": "gt",
                  "args": [
                    "wheel_slip",
                    0.12
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "actuate",
      "period_ms": 10,
      "assign": {
        "pressure": {
          "op": "if",
          "args": [
            "abs_active",
            {
              "op": "mul",
              "args": [
                "brake",
                0.45
              ]
            },
            "brake"
          ]
        }
      }
    }
  ],
  "bindings": {
    "brake_pressure": "pressure"
  },
  "messages": [
    {
      "name": "BrakeStatus",
      "id": 544,
      "dlc": 8,
      "direction": "tx",
      "signals": [
        {
          "name": "abs_active",
          "start": 0,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "pressure",
          "start": 8,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "ratio",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "wheel_slip",
          "start": 24,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "ratio",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "period_ms": 20
    }
  ],
  "state_machine": {
    "initial": "OFF",
    "states": [
      "OFF",
      "RUN",
      "ABS_ACTIVE"
    ],
    "transitions": [
      {
        "from": "OFF",
        "to": "RUN",
        "when": "ignition"
      },
      {
        "from": "RUN",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      },
      {
        "from": "RUN",
        "to": "ABS_ACTIVE",
        "when": "abs_active"
      },
      {
        "from": "ABS_ACTIVE",
        "to": "RUN",
        "when": {
          "op": "eq",
          "args": [
            "abs_active",
            0
          ]
        }
      },
      {
        "from": "ABS_ACTIVE",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      }
    ]
  },
  "dtcs": [],
  "assumptions": [
    "Generic educational model; not an OEM controller.",
    "Classic CAN, little-endian signals, 10 ms simulation step."
  ]
}
