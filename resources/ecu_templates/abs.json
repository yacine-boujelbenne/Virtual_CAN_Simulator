{
  "schema_version": 1,
  "name": "ABS ECU",
  "inputs": [
    "ignition",
    "brake",
    "speed_sensor",
    "wheel_fl_sensor",
    "wheel_fr_sensor",
    "wheel_rl_sensor",
    "wheel_rr_sensor",
    "aeb_request",
    "acc_throttle",
    "acc_active",
    "fcw",
    "time_to_collision"
  ],
  "variables": {
    "wheel_slip": 0,
    "abs_active": 0,
    "pressure": 0,
    "combined_brake": 0
  },
  "tasks": [
    {
      "name": "brake_request_arbitration",
      "period_ms": 10,
      "cost_us": 100,
      "assign": {
        "combined_brake": {
          "op": "max",
          "args": [
            "brake",
            "aeb_request"
          ]
        }
      }
    },
    {
      "name": "slip",
      "period_ms": 10,
      "assign": {
        "wheel_slip": {
          "op": "max",
          "args": [
            0,
            {
              "op": "div",
              "args": [
                {
                  "op": "sub",
                  "args": [
                    "speed_sensor",
                    {
                      "op": "min",
                      "args": [
                        {
                          "op": "min",
                          "args": [
                            "wheel_fl_sensor",
                            "wheel_fr_sensor"
                          ]
                        },
                        {
                          "op": "min",
                          "args": [
                            "wheel_rl_sensor",
                            "wheel_rr_sensor"
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "op": "max",
                  "args": [
                    "speed_sensor",
                    0.5
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "abs_control",
      "period_ms": 10,
      "assign": {
        "abs_active": {
          "op": "and",
          "args": [
            {
              "op": "gt",
              "args": [
                "speed_sensor",
                2
              ]
            },
            {
              "op": "and",
              "args": [
                {
                  "op": "gt",
                  "args": [
                    "combined_brake",
                    0.05
                  ]
                },
                {
                  "op": "gt",
                  "args": [
                    "wheel_slip",
                    0.12
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "actuate",
      "period_ms": 10,
      "assign": {
        "pressure": {
          "op": "if",
          "args": [
            "abs_active",
            {
              "op": "mul",
              "args": [
                "combined_brake",
                0.45
              ]
            },
            "combined_brake"
          ]
        }
      }
    }
  ],
  "bindings": {
    "brake_pressure": "pressure"
  },
  "messages": [
    {
      "name": "BrakeStatus",
      "id": 544,
      "dlc": 8,
      "direction": "tx",
      "signals": [
        {
          "name": "abs_active",
          "start": 0,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "pressure",
          "start": 8,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "ratio",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "wheel_slip",
          "start": 24,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "ratio",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "period_ms": 20,
      "bus": "powertrain",
      "fd": false,
      "brs": false
    },
    {
      "name": "ADASControl",
      "id": 1104,
      "direction": "rx",
      "dlc": 8,
      "fd": false,
      "brs": false,
      "bus": "powertrain",
      "signals": [
        {
          "name": "aeb_request",
          "start": 0,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "acc_throttle",
          "start": 16,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "acc_active",
          "start": 32,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "fcw",
          "start": 33,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "time_to_collision",
          "start": 40,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 99,
          "unit": "s",
          "signed": false,
          "byte_order": "little_endian"
        }
      ]
    }
  ],
  "state_machine": {
    "initial": "OFF",
    "states": [
      "OFF",
      "RUN",
      "ABS_ACTIVE"
    ],
    "transitions": [
      {
        "from": "OFF",
        "to": "RUN",
        "when": "ignition"
      },
      {
        "from": "RUN",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      },
      {
        "from": "RUN",
        "to": "ABS_ACTIVE",
        "when": "abs_active"
      },
      {
        "from": "ABS_ACTIVE",
        "to": "RUN",
        "when": {
          "op": "eq",
          "args": [
            "abs_active",
            0
          ]
        }
      },
      {
        "from": "ABS_ACTIVE",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      }
    ]
  },
  "dtcs": [],
  "assumptions": [
    "Generic educational model; not an OEM controller.",
    "Classic CAN, little-endian signals, 10 ms simulation step."
  ],
  "hardware": {
    "cpu_mhz": 120,
    "ram_kib": 128,
    "flash_kib": 512,
    "task_budget_us": 8000,
    "adc": {
      "resolution_bits": 12,
      "channels": {
        "brake": [
          0,
          1
        ]
      }
    },
    "can_controller": {
      "fd_capable": true,
      "rx_fifo_frames": 128
    },
    "gpio_outputs": []
  },
  "domain": "Chassis"
}
