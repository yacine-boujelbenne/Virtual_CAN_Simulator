{
  "schema_version": 1,
  "name": "Transmission ECU",
  "inputs": [
    "ignition",
    "gear",
    "speed_sensor"
  ],
  "variables": {
    "gear_position": 0,
    "drive_permit": 0
  },
  "tasks": [
    {
      "name": "select",
      "period_ms": 10,
      "cost_us": 80,
      "assign": {
        "gear_position": {
          "op": "max",
          "args": [
            {
              "op": "min",
              "args": [
                "gear",
                2
              ]
            },
            0
          ]
        }
      }
    },
    {
      "name": "permit",
      "period_ms": 10,
      "cost_us": 80,
      "assign": {
        "drive_permit": {
          "op": "if",
          "args": [
            {
              "op": "and",
              "args": [
                "ignition",
                {
                  "op": "eq",
                  "args": [
                    "gear_position",
                    2
                  ]
                }
              ]
            },
            1,
            0
          ]
        }
      }
    }
  ],
  "bindings": {
    "gear_position": "gear_position",
    "drive_permit": "drive_permit"
  },
  "messages": [
    {
      "name": "DriveStatus",
      "id": 608,
      "dlc": 8,
      "direction": "tx",
      "signals": [
        {
          "name": "drive_permit",
          "start": 0,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "period_ms": 10,
      "bus": "powertrain",
      "fd": false,
      "brs": false
    },
    {
      "name": "GearStatus",
      "id": 609,
      "dlc": 8,
      "direction": "tx",
      "signals": [
        {
          "name": "gear_position",
          "start": 0,
          "length": 2,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 2,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "period_ms": 20,
      "bus": "powertrain",
      "fd": false,
      "brs": false
    }
  ],
  "state_machine": {
    "initial": "OFF",
    "states": [
      "OFF",
      "RUN"
    ],
    "transitions": [
      {
        "from": "OFF",
        "to": "RUN",
        "when": "ignition"
      },
      {
        "from": "RUN",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      }
    ]
  },
  "dtcs": [],
  "assumptions": [
    "Generic educational transmission model; not an OEM controller.",
    "Gear encoding is 0=P, 1=N, 2=D. Reverse is not implemented.",
    "Drive permit is broadcast to the motor controller over CAN.",
    "The vehicle plant enforces the parking interlock at actuation time: a delayed Park engagement above park_speed_mps cannot lock the driveline instantly and instead completes a declared pre-lock braking ramp (park_brake_mps2)."
  ],
  "hardware": {
    "cpu_mhz": 120,
    "ram_kib": 128,
    "flash_kib": 512,
    "task_budget_us": 8000,
    "adc": {
      "resolution_bits": 12,
      "channels": {}
    },
    "can_controller": {
      "fd_capable": true,
      "rx_fifo_frames": 128
    },
    "gpio_outputs": []
  },
  "domain": "Powertrain"
}
