{
  "schema_version": 1,
  "name": "ADAS ECU",
  "inputs": [
    "ignition",
    "assist_enabled",
    "target_speed",
    "aeb_enabled",
    "brake",
    "object_range",
    "object_closing_speed",
    "object_confidence",
    "radar_valid",
    "vehicle_speed",
    "vehicle_rpm",
    "radar_age_ms"
  ],
  "variables": {
    "time_to_collision": 99,
    "aeb_request": 0,
    "acc_throttle": 0,
    "acc_active": 0,
    "fcw": 0,
    "adas_fault": 0,
    "startup_ms": 0
  },
  "tasks": [
    {
      "name": "fusion",
      "period_ms": 10,
      "cost_us": 450,
      "assign": {
        "time_to_collision": {
          "op": "min",
          "args": [
            99,
            {
              "op": "div",
              "args": [
                "object_range",
                {
                  "op": "max",
                  "args": [
                    "object_closing_speed",
                    0.1
                  ]
                }
              ]
            }
          ]
        },
        "adas_fault": {
          "op": "if",
          "args": [
            {
              "op": "lt",
              "args": [
                "startup_ms",
                100
              ]
            },
            0,
            {
              "op": "or",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    "radar_valid",
                    0
                  ]
                },
                {
                  "op": "gt",
                  "args": [
                    "radar_age_ms",
                    100
                  ]
                }
              ]
            }
          ]
        },
        "startup_ms": {
          "op": "min",
          "args": [
            200,
            {
              "op": "add",
              "args": [
                "startup_ms",
                10
              ]
            }
          ]
        }
      }
    },
    {
      "name": "collision_warning",
      "period_ms": 10,
      "cost_us": 180,
      "assign": {
        "fcw": {
          "op": "and",
          "args": [
            {
              "op": "eq",
              "args": [
                "adas_fault",
                0
              ]
            },
            {
              "op": "and",
              "args": [
                "radar_valid",
                {
                  "op": "lt",
                  "args": [
                    "time_to_collision",
                    3
                  ]
                }
              ]
            }
          ]
        },
        "aeb_request": {
          "op": "if",
          "args": [
            {
              "op": "and",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    "adas_fault",
                    0
                  ]
                },
                {
                  "op": "and",
                  "args": [
                    {
                      "op": "and",
                      "args": [
                        "aeb_enabled",
                        "ignition"
                      ]
                    },
                    {
                      "op": "and",
                      "args": [
                        "radar_valid",
                        {
                          "op": "and",
                          "args": [
                            {
                              "op": "gt",
                              "args": [
                                "vehicle_speed",
                                1
                              ]
                            },
                            {
                              "op": "or",
                              "args": [
                                {
                                  "op": "lt",
                                  "args": [
                                    "time_to_collision",
                                    2
                                  ]
                                },
                                {
                                  "op": "lt",
                                  "args": [
                                    "object_range",
                                    5
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            1,
            0
          ]
        }
      }
    },
    {
      "name": "cruise_control",
      "period_ms": 10,
      "cost_us": 350,
      "assign": {
        "acc_active": {
          "op": "and",
          "args": [
            {
              "op": "and",
              "args": [
                "assist_enabled",
                "ignition"
              ]
            },
            {
              "op": "and",
              "args": [
                {
                  "op": "eq",
                  "args": [
                    "adas_fault",
                    0
                  ]
                },
                {
                  "op": "eq",
                  "args": [
                    "brake",
                    0
                  ]
                }
              ]
            }
          ]
        },
        "acc_throttle": {
          "op": "if",
          "args": [
            {
              "op": "gt",
              "args": [
                "object_range",
                {
                  "op": "add",
                  "args": [
                    6,
                    {
                      "op": "mul",
                      "args": [
                        "vehicle_speed",
                        0.42
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "op": "min",
              "args": [
                0.7,
                {
                  "op": "max",
                  "args": [
                    0,
                    {
                      "op": "mul",
                      "args": [
                        {
                          "op": "sub",
                          "args": [
                            "target_speed",
                            "vehicle_speed"
                          ]
                        },
                        0.018
                      ]
                    }
                  ]
                }
              ]
            },
            0
          ]
        }
      }
    }
  ],
  "bindings": {},
  "messages": [
    {
      "name": "RadarObjectList",
      "id": 1024,
      "direction": "rx",
      "dlc": 32,
      "fd": true,
      "brs": true,
      "bus": "adas",
      "signals": [
        {
          "name": "object_range",
          "start": 0,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 600,
          "unit": "m",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "object_closing_speed",
          "start": 16,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 80,
          "unit": "m/s",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "object_confidence",
          "start": 80,
          "length": 8,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 100,
          "unit": "%",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "radar_valid",
          "start": 96,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        }
      ]
    },
    {
      "name": "VehicleStatus",
      "id": 288,
      "dlc": 8,
      "direction": "rx",
      "signals": [
        {
          "name": "vehicle_speed",
          "start": 0,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 288,
          "unit": "km/h",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "vehicle_rpm",
          "start": 16,
          "length": 16,
          "factor": 0.25,
          "offset": 0,
          "min": 0,
          "max": 16000,
          "unit": "rpm",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "bus": "adas",
      "fd": false,
      "brs": false
    },
    {
      "name": "ADASControl",
      "id": 1104,
      "direction": "tx",
      "period_ms": 10,
      "dlc": 8,
      "fd": false,
      "brs": false,
      "bus": "adas",
      "signals": [
        {
          "name": "aeb_request",
          "start": 0,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "acc_throttle",
          "start": 16,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "acc_active",
          "start": 32,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "fcw",
          "start": 33,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "time_to_collision",
          "start": 40,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 99,
          "unit": "s",
          "signed": false,
          "byte_order": "little_endian"
        }
      ]
    }
  ],
  "state_machine": {
    "initial": "OFF",
    "states": [
      "OFF",
      "MONITORING",
      "CRUISE",
      "WARNING",
      "BRAKING",
      "FAULT"
    ],
    "transitions": [
      {
        "from": "OFF",
        "to": "MONITORING",
        "when": "ignition"
      },
      {
        "from": "MONITORING",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      },
      {
        "from": "CRUISE",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      },
      {
        "from": "WARNING",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      },
      {
        "from": "BRAKING",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      },
      {
        "from": "FAULT",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      },
      {
        "from": "MONITORING",
        "to": "FAULT",
        "when": "adas_fault"
      },
      {
        "from": "CRUISE",
        "to": "FAULT",
        "when": "adas_fault"
      },
      {
        "from": "WARNING",
        "to": "FAULT",
        "when": "adas_fault"
      },
      {
        "from": "BRAKING",
        "to": "FAULT",
        "when": "adas_fault"
      },
      {
        "from": "MONITORING",
        "to": "BRAKING",
        "when": "aeb_request"
      },
      {
        "from": "CRUISE",
        "to": "BRAKING",
        "when": "aeb_request"
      },
      {
        "from": "WARNING",
        "to": "BRAKING",
        "when": "aeb_request"
      },
      {
        "from": "MONITORING",
        "to": "WARNING",
        "when": "fcw"
      },
      {
        "from": "CRUISE",
        "to": "WARNING",
        "when": "fcw"
      },
      {
        "from": "MONITORING",
        "to": "CRUISE",
        "when": "acc_active"
      },
      {
        "from": "CRUISE",
        "to": "MONITORING",
        "when": {
          "op": "eq",
          "args": [
            "acc_active",
            0
          ]
        }
      },
      {
        "from": "WARNING",
        "to": "MONITORING",
        "when": {
          "op": "eq",
          "args": [
            "fcw",
            0
          ]
        }
      },
      {
        "from": "BRAKING",
        "to": "MONITORING",
        "when": {
          "op": "eq",
          "args": [
            "aeb_request",
            0
          ]
        }
      },
      {
        "from": "FAULT",
        "to": "MONITORING",
        "when": {
          "op": "eq",
          "args": [
            "adas_fault",
            0
          ]
        }
      }
    ]
  },
  "dtcs": [
    {
      "code": "C1A50",
      "uds_code": 12690688,
      "name": "ADAS perception input unavailable",
      "severity": "warning",
      "trigger": "adas_fault",
      "recover": {
        "op": "eq",
        "args": [
          "adas_fault",
          0
        ]
      }
    }
  ],
  "assumptions": [
    "Functional software-in-the-loop demonstration; not production ADAS/ADS.",
    "Radar observations are synthetic sensor measurements, not raw camera/radar perception."
  ],
  "hardware": {
    "cpu_mhz": 240,
    "ram_kib": 256,
    "flash_kib": 1024,
    "task_budget_us": 8000,
    "adc": {
      "resolution_bits": 12,
      "channels": {}
    },
    "can_controller": {
      "fd_capable": true,
      "rx_fifo_frames": 128
    },
    "gpio_outputs": []
  },
  "domain": "Assistance",
  "freshness_inputs": {
    "radar_age_ms": {
      "id": 1024,
      "bus": "adas"
    }
  }
}
