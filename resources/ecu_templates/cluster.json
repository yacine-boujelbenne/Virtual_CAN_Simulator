{
  "schema_version": 1,
  "name": "Instrument Cluster",
  "inputs": [
    "ignition",
    "vehicle_speed",
    "vehicle_rpm",
    "motor_rpm",
    "motor_temperature",
    "motor_torque",
    "motor_fault",
    "battery_soc",
    "pack_voltage",
    "pack_current",
    "battery_fault",
    "power_permit",
    "abs_active",
    "pressure",
    "wheel_slip",
    "aeb_request",
    "acc_throttle",
    "acc_active",
    "fcw",
    "time_to_collision"
  ],
  "variables": {
    "display_speed": 0,
    "display_rpm": 0,
    "display_soc": 85,
    "warning": 0,
    "display_ttc": 99
  },
  "tasks": [
    {
      "name": "display",
      "period_ms": 10,
      "assign": {
        "display_speed": "vehicle_speed",
        "display_rpm": "motor_rpm",
        "display_soc": "battery_soc",
        "warning": {
          "op": "or",
          "args": [
            {
              "op": "or",
              "args": [
                "motor_fault",
                "battery_fault"
              ]
            },
            "fcw"
          ]
        },
        "display_ttc": "time_to_collision"
      }
    }
  ],
  "bindings": {},
  "messages": [
    {
      "name": "VehicleStatus",
      "id": 288,
      "dlc": 8,
      "direction": "rx",
      "signals": [
        {
          "name": "vehicle_speed",
          "start": 0,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 288,
          "unit": "km/h",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "vehicle_rpm",
          "start": 16,
          "length": 16,
          "factor": 0.25,
          "offset": 0,
          "min": 0,
          "max": 16000,
          "unit": "rpm",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "bus": "powertrain",
      "fd": false,
      "brs": false
    },
    {
      "name": "MotorStatus",
      "id": 256,
      "dlc": 8,
      "direction": "rx",
      "signals": [
        {
          "name": "motor_rpm",
          "start": 0,
          "length": 16,
          "factor": 0.25,
          "offset": 0,
          "min": 0,
          "max": 16000,
          "unit": "rpm",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "motor_temperature",
          "start": 16,
          "length": 16,
          "factor": 0.01,
          "offset": -40,
          "min": -40,
          "max": 150,
          "unit": "\u00b0C",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "motor_torque",
          "start": 32,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 320,
          "unit": "Nm",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "motor_fault",
          "start": 48,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "bus": "powertrain",
      "fd": false,
      "brs": false
    },
    {
      "name": "BatteryStatus",
      "id": 784,
      "dlc": 8,
      "direction": "rx",
      "signals": [
        {
          "name": "battery_soc",
          "start": 0,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 100,
          "unit": "%",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "pack_voltage",
          "start": 16,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 600,
          "unit": "V",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "pack_current",
          "start": 32,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": -300,
          "max": 300,
          "unit": "A",
          "signed": true,
          "byte_order": "little_endian"
        },
        {
          "name": "battery_fault",
          "start": 48,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "power_permit",
          "start": 49,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "bus": "powertrain",
      "fd": false,
      "brs": false
    },
    {
      "name": "BrakeStatus",
      "id": 544,
      "dlc": 8,
      "direction": "rx",
      "signals": [
        {
          "name": "abs_active",
          "start": 0,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "pressure",
          "start": 8,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "ratio",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "wheel_slip",
          "start": 24,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "ratio",
          "signed": false,
          "byte_order": "little_endian"
        }
      ],
      "bus": "powertrain",
      "fd": false,
      "brs": false
    },
    {
      "name": "ADASControl",
      "id": 1104,
      "direction": "rx",
      "dlc": 8,
      "fd": false,
      "brs": false,
      "bus": "powertrain",
      "signals": [
        {
          "name": "aeb_request",
          "start": 0,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "acc_throttle",
          "start": 16,
          "length": 16,
          "factor": 0.0001,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "acc_active",
          "start": 32,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "fcw",
          "start": 33,
          "length": 1,
          "factor": 1,
          "offset": 0,
          "min": 0,
          "max": 1,
          "unit": "",
          "signed": false,
          "byte_order": "little_endian"
        },
        {
          "name": "time_to_collision",
          "start": 40,
          "length": 16,
          "factor": 0.01,
          "offset": 0,
          "min": 0,
          "max": 99,
          "unit": "s",
          "signed": false,
          "byte_order": "little_endian"
        }
      ]
    }
  ],
  "state_machine": {
    "initial": "OFF",
    "states": [
      "OFF",
      "RUN"
    ],
    "transitions": [
      {
        "from": "OFF",
        "to": "RUN",
        "when": "ignition"
      },
      {
        "from": "RUN",
        "to": "OFF",
        "when": {
          "op": "eq",
          "args": [
            "ignition",
            0
          ]
        }
      }
    ]
  },
  "dtcs": [],
  "assumptions": [
    "Generic educational model; not an OEM controller.",
    "Classic CAN, little-endian signals, 10 ms simulation step."
  ],
  "hardware": {
    "cpu_mhz": 120,
    "ram_kib": 128,
    "flash_kib": 512,
    "task_budget_us": 8000,
    "adc": {
      "resolution_bits": 12,
      "channels": {}
    },
    "can_controller": {
      "fd_capable": true,
      "rx_fifo_frames": 128
    },
    "gpio_outputs": []
  },
  "domain": "HMI"
}
