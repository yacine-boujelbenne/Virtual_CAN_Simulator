{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:virtual-vehicle-lab:ecu:1",
  "title": "Virtual ECU Definition v1",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "inputs",
    "variables",
    "tasks",
    "bindings",
    "state_machine",
    "messages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "inputs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "variables": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": {
        "type": [
          "number",
          "boolean"
        ]
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "period_ms",
          "assign"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "period_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60000
          },
          "assign": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/expression"
            }
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "torque_request",
          "brake_pressure",
          "fan",
          "power_allowed"
        ]
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "state_machine": {
      "type": "object",
      "required": [
        "initial",
        "states",
        "transitions"
      ],
      "properties": {
        "initial": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "when"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "when": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/message"
      }
    },
    "dtcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "uds_code",
          "name",
          "trigger",
          "recover"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "uds_code": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777215
          },
          "name": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "trigger": {
            "$ref": "#/$defs/expression"
          },
          "recover": {
            "$ref": "#/$defs/expression"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hardware": {
      "type": "object",
      "properties": {
        "cpu_mhz": {
          "type": "number",
          "minimum": 1,
          "maximum": 2000
        },
        "ram_kib": {
          "type": "integer",
          "minimum": 1
        },
        "flash_kib": {
          "type": "integer",
          "minimum": 1
        },
        "task_budget_us": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "adc": {
          "type": "object"
        },
        "can_controller": {
          "type": "object"
        },
        "gpio_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "freshness_inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 0
          },
          "bus": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "expression": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "add",
                "sub",
                "mul",
                "div",
                "gt",
                "lt",
                "ge",
                "le",
                "eq",
                "and",
                "or",
                "min",
                "max",
                "if"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/expression"
              }
            }
          }
        }
      ]
    },
    "signal": {
      "type": "object",
      "required": [
        "name",
        "start",
        "length",
        "min",
        "max"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "factor": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "signed": {
          "type": "boolean"
        },
        "byte_order": {
          "const": "little_endian"
        }
      }
    },
    "message": {
      "type": "object",
      "required": [
        "name",
        "id",
        "direction",
        "signals"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 536870911
        },
        "extended": {
          "type": "boolean"
        },
        "dlc": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "direction": {
          "enum": [
            "tx",
            "rx"
          ]
        },
        "period_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "signals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/signal"
          }
        },
        "fd": {
          "type": "boolean"
        },
        "brs": {
          "type": "boolean"
        },
        "bus": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "direction": {
                "const": "tx"
              }
            }
          },
          "then": {
            "required": [
              "period_ms"
            ]
          }
        }
      ]
    }
  }
}
